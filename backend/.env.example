# =============================================================================
# InsightForge AI - Backend Environment Configuration Sample
# Copy to .env and adjust values for your environment.
# =============================================================================

# Application Runtime
IF_APP_NAME="InsightForge AI API"
IF_APP_VERSION="0.1.0"
IF_ENVIRONMENT=development
IF_DEBUG=true
IF_API_V1_PREFIX="/api/v1"

# CORS Allowed Origins (comma-separated)
IF_CORS_ORIGINS=http://localhost:3000

# Security & Authentication
# IMPORTANT: Generate a 64-character secret in production using: openssl rand -hex 32
IF_SECRET_KEY=super-secret-key-for-dev-only-change-in-production-min32
IF_ALGORITHM=HS256
IF_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL with psycopg 3)
IF_DATABASE_URL=postgresql+psycopg://insightforge:insightforge@db:5432/insightforge
IF_DB_ECHO=false
IF_DB_POOL_SIZE=5
IF_DB_MAX_OVERFLOW=10

# Redis Cache & Message Broker
IF_REDIS_URL=redis://redis:6379/0

# Object Storage Configuration (local or s3)
IF_STORAGE_BACKEND=local
IF_STORAGE_LOCAL_DIR=/app/data/raw

# AI & LLM Provider Configuration (deterministic fallback active if key omitted)
IF_LLM_PROVIDER=openai
IF_OPENAI_API_KEY=
IF_OPENAI_API_BASE=https://api.openai.com/v1
IF_OPENAI_MODEL=gpt-4o-mini
IF_GEMINI_API_KEY=
