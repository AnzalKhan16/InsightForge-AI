# =============================================================================
# InsightForge AI - Root Docker Compose Environment Sample
# Copy to .env to customize local or production container deployment.
# =============================================================================

# Project Namespace
COMPOSE_PROJECT_NAME=insightforge

# Database Credentials
POSTGRES_USER=insightforge
POSTGRES_PASSWORD=insightforge_secure_pass_2026
POSTGRES_DB=insightforge
POSTGRES_PORT=5432

# Redis Cache
REDIS_PORT=6379

# Backend Settings
BACKEND_PORT=8000
IF_SECRET_KEY=generate_a_secure_random_64_character_key_here
IF_ENVIRONMENT=development
IF_DEBUG=true
IF_CORS_ORIGINS=http://localhost:3000

# Frontend Settings
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional AI API Keys (leave blank for deterministic offline fallback mode)
OPENAI_API_KEY=
GEMINI_API_KEY=
